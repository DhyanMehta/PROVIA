# Optional local configuration. External service credentials are not required.
APP_NAME=provia-api
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=false
# Body limit checked before JSON parsing; 16 MiB by default.
MAX_REQUEST_BODY_BYTES=16777216
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=false
LOG_LEVEL=INFO
DATABASE_URL=
DIRECT_DATABASE_URL=
# Server-only random signing secret: generate at least 32 random bytes.
AUTH_JWT_SECRET=
AUTH_TOKEN_ISSUER=https://provia-mag7.onrender.com
AUTH_TOKEN_AUDIENCE=provia-mobile
AUTH_ACCESS_SECONDS=900
AUTH_REFRESH_DAYS=30
# Leave empty until the immediate Render proxy network is explicitly verified.
AUTH_TRUSTED_PROXY_CIDRS=[]
# Render Free blocks standard SMTP ports. Use the optional Resend HTTPS adapter
# after setting up its Free plan and verifying the permitted sender/recipient.
AUTH_EMAIL_PROVIDER=smtp
RESEND_API_KEY=
RESEND_FROM=
# Optional SMTP over verified TLS for environments that permit it.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NUTRITION_MIN_DAILY_CALORIES=1500
USDA_API_KEY=
FOOD_HTTP_TIMEOUT_SECONDS=5
FOOD_PROVIDER_CACHE_SECONDS=300
FOOD_PROVIDER_STALE_SECONDS=3600
FOOD_PROVIDER_MIN_INTERVAL_SECONDS=6
OFF_USER_AGENT="PROVIA/0.1.0 (replace with your contact email before live use)"
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Dedicated disposable PostgreSQL database ONLY; never your app or production database.
# Tests create/drop randomly named provia_test_* schemas in this database.
TEST_DATABASE_URL=
TEST_DATABASE_DISPOSABLE=false
